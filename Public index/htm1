<!doctype html>
<html lang="hi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>For You — AI Study Assistant</title>
<style>
*{box-sizing:border-box}
body{
  margin:0;font-family:Arial,sans-serif;color:#eef2ff;
  background:
    radial-gradient(circle at 15% 10%,#2738a8 0,transparent 30%),
    radial-gradient(circle at 85% 20%,#7b21c9 0,transparent 28%),
    linear-gradient(135deg,#080b22,#10154a 48%,#090b24);
  min-height:100vh
}
header{
  position:sticky;top:0;z-index:10;text-align:center;padding:20px 16px;
  font-size:27px;font-weight:800;letter-spacing:.5px;color:white;
  background:rgba(9,12,38,.78);backdrop-filter:blur(14px);
  border-bottom:1px solid #ffffff18;box-shadow:0 8px 30px #0005
}
.wrap{max-width:720px;margin:auto;padding:18px}
.card{
  background:rgba(20,26,66,.82);border:1px solid #ffffff18;
  border-radius:22px;padding:19px;margin:13px 0;
  box-shadow:0 12px 35px #0005;backdrop-filter:blur(12px)
}
button,select,input,textarea{font:inherit}
button{
  border:1px solid #ffffff18;border-radius:14px;padding:13px 16px;
  background:linear-gradient(135deg,#5b5cf0,#9b4dff);color:white;
  font-weight:800;cursor:pointer;box-shadow:0 7px 20px #5b5cf044;
  transition:.2s
}
button:hover{transform:translateY(-2px);box-shadow:0 10px 25px #8b5cf666}
button.secondary{background:#20275d;color:#dfe4ff}
button.gray{background:#252b4d;color:#e9edff}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:13px}
@media(max-width:520px){.grid{grid-template-columns:1fr}}
textarea{
  width:100%;min-height:105px;border:1px solid #ffffff20;border-radius:15px;
  padding:13px;resize:vertical;background:#0d1235;color:white;outline:none
}
textarea::placeholder{color:#8f98bf}
select,input[type=file]{
  width:100%;padding:12px;border:1px solid #ffffff20;border-radius:12px;
  background:#11173e;color:white
}
.title{font-size:23px;font-weight:800;margin-bottom:8px}
.muted{color:#aab3d5}
.top{display:flex;justify-content:space-between;align-items:center;gap:10px}
.score{
  font-weight:800;background:#171d4b;padding:8px 11px;border-radius:12px;
  border:1px solid #ffffff16
}
.small{font-size:14px}
.option{
  display:block;width:100%;text-align:left;background:#181f4c;color:#eef2ff;
  margin:9px 0;border:1px solid #ffffff14
}
.option:hover{background:#292f70}
.correct{background:#137a58!important;border-color:#42e6a7!important}
.wrong{background:#8b2942!important;border-color:#ff7290!important}
.hidden{display:none!important}
.links a{display:block;margin:11px 0;color:#aeb5ff;font-weight:800;text-decoration:none}
#answer{color:#e8ebff}
</style>
</head>
<body>
<header>For You ✦ 📚🤖<div style="font-size:12px;font-weight:600;color:#aeb5ff;margin-top:5px">AI Study • Quiz • Puzzle • Books</div></header>

<div class="wrap">

<section id="home">
  <div class="card">
    <div class="title">AI Study Assistant</div>
    <p class="muted">Question likho, voice bolo, photo select karo, quiz/puzzle khelo aur books dekho.</p>
    <textarea id="question" placeholder="Apna question yahan likho..."></textarea>
    <div style="margin-top:10px;display:flex;gap:8px;flex-wrap:wrap">
      <button id="askBtn">🤖 Answer</button>
      <button id="voiceBtn" class="secondary">🎤 Voice</button>
    </div>
    <div id="answer" class="card hidden" style="margin-top:14px;background:#f8f9ff"></div>
  </div>

  <div class="grid">
    <button id="quizBtn">📝 Quiz</button>
    <button id="puzzleBtn">🧩 Puzzle</button>
    <button id="booksBtn" class="secondary">📚 Books</button>
    <button id="photoBtn" class="secondary">📷 Photo Question</button>
  </div>

  <div class="card hidden" id="photoBox">
    <div class="title">📷 Photo Question</div>
    <input id="photoInput" type="file" accept="image/*">
    <p class="muted small">Photo select ho jayegi. Real AI image answer ke liye backend/API connect karna hoga.</p>
  </div>
</section>

<section id="game" class="hidden">
  <div class="top">
    <button id="backGame" class="gray">← Back</button>
    <div id="gameTitle" class="title"></div>
    <div class="score" id="score">Score: 0</div>
  </div>
  <div class="card">
    <div id="difficulty"></div>
    <div id="questionNo" class="muted small"></div>
    <h2 id="gameQuestion"></h2>
    <div id="options"></div>
    <button id="hintBtn" class="secondary">💡 Hint</button>
    <p id="hintText" class="muted"></p>
    <p id="feedback"></p>
    <button id="nextBtn" class="hidden">Next →</button>
  </div>
</section>

<section id="books" class="hidden">
  <button id="backBooks" class="gray">← Back</button>
  <div class="card">
    <div class="title">📚 Books</div>
    <select id="classSelect">
      <option>Class 1</option><option>Class 2</option><option>Class 3</option>
      <option>Class 4</option><option>Class 5</option><option>Class 6</option>
      <option>Class 7</option><option>Class 8</option><option>Class 9</option>
      <option>Class 10</option><option>Class 11</option><option>Class 12</option>
    </select>
    <select id="mediumSelect" style="margin-top:10px">
      <option>English</option><option>Hindi</option><option>Assamese</option><option>Bengali</option>
    </select>
    <div class="links" style="margin-top:16px">
      <a href="https://ncert.nic.in/textbook.php" target="_blank">📖 NCERT Textbooks</a>
      <a href="https://epathshala.nic.in/" target="_blank">📚 ePathshala</a>
    </div>
  </div>
</section>

</div>

<script>
(function(){
  const HOME=document.getElementById("home");
  const GAME=document.getElementById("game");
  const BOOKS=document.getElementById("books");
  const PHOTOBOX=document.getElementById("photoBox");

  const quizQuestions=[
    {q:"भारत की राजधानी क्या है?",o:["मुंबई","नई दिल्ली","कोलकाता","चेन्नई"],a:1,h:"यह शहर भारत सरकार का मुख्य केंद्र है।"},
    {q:"2 + 3 कितना होता है?",o:["4","5","6","7"],a:1,h:"दो के बाद तीन गिनो।"},
    {q:"पानी का रासायनिक सूत्र क्या है?",o:["CO₂","O₂","H₂O","NaCl"],a:2,h:"इसमें Hydrogen और Oxygen होते हैं।"}
  ];
  const puzzleQuestions=[
    {q:"अगर 2, 4, 6, 8 के बाद अगली संख्या क्या होगी?",o:["9","10","11","12"],a:1,h:"हर बार 2 बढ़ रहा है।"},
    {q:"एक सप्ताह में कितने दिन होते हैं?",o:["5","6","7","8"],a:2,h:"Monday से Sunday तक गिनो।"},
    {q:"अगर A=1, B=2, C=3, तो C कितना है?",o:["1","2","3","4"],a:2,h:"Alphabet में C तीसरा अक्षर है।"}
  ];

  let currentSet=[], currentIndex=0, score=0, gameType="", answered=false;

  function showOnly(section){
    HOME.classList.add("hidden");
    GAME.classList.add("hidden");
    BOOKS.classList.add("hidden");
    section.classList.remove("hidden");
  }

  function startGame(type){
    gameType=type;
    currentSet=(type==="quiz"?quizQuestions:puzzleQuestions);
    currentIndex=0; score=0; answered=false;
    document.getElementById("gameTitle").textContent=type==="quiz"?"📝 Quiz":"🧩 Puzzle";
    document.getElementById("score").textContent="Score: 0";
    showOnly(GAME);
    renderQuestion();
  }

  function renderQuestion(){
    const item=currentSet[currentIndex];
    answered=false;
    document.getElementById("questionNo").textContent="Question "+(currentIndex+1)+" / "+currentSet.length;
    document.getElementById("gameQuestion").textContent=item.q;
    document.getElementById("hintText").textContent="";
    document.getElementById("feedback").textContent="";
    document.getElementById("nextBtn").classList.add("hidden");
    const box=document.getElementById("options");
    box.innerHTML="";
    item.o.forEach((option,i)=>{
      const b=document.createElement("button");
      b.className="option";
      b.textContent=option;
      b.addEventListener("click",()=>chooseAnswer(i,b));
      box.appendChild(b);
    });
  }

  function chooseAnswer(index,button){
    if(answered)return;
    answered=true;
    const item=currentSet[currentIndex];
    const buttons=document.querySelectorAll("#options .option");
    buttons.forEach((b,i)=>{
      b.disabled=true;
      if(i===item.a)b.classList.add("correct");
    });
    const feedback=document.getElementById("feedback");
    if(index===item.a){
      score++;
      button.classList.add("correct");
      feedback.textContent="✅ Sahi jawab!";
    }else{
      button.classList.add("wrong");
      feedback.textContent="❌ Galat. Sahi jawab: "+item.o[item.a];
    }
    document.getElementById("score").textContent="Score: "+score;
    document.getElementById("nextBtn").classList.remove("hidden");
    document.getElementById("nextBtn").textContent=currentIndex===currentSet.length-1?"Finish":"Next →";
  }

  document.getElementById("quizBtn").addEventListener("click",()=>startGame("quiz"));
  document.getElementById("puzzleBtn").addEventListener("click",()=>startGame("puzzle"));

  document.getElementById("hintBtn").addEventListener("click",()=>{
    document.getElementById("hintText").textContent="💡 Hint: "+currentSet[currentIndex].h;
  });

  document.getElementById("nextBtn").addEventListener("click",()=>{
    if(currentIndex<currentSet.length-1){
      currentIndex++;
      renderQuestion();
    }else{
      document.getElementById("gameQuestion").textContent="🎉 Game complete!";
      document.getElementById("options").innerHTML="";
      document.getElementById("feedback").textContent="Final Score: "+score+" / "+currentSet.length;
      document.getElementById("hintText").textContent="Achha kiya! 😊";
      document.getElementById("nextBtn").classList.add("hidden");
    }
  });

  document.getElementById("backGame").addEventListener("click",()=>showOnly(HOME));
  document.getElementById("booksBtn").addEventListener("click",()=>showOnly(BOOKS));
  document.getElementById("backBooks").addEventListener("click",()=>showOnly(HOME));

  document.getElementById("photoBtn").addEventListener("click",()=>{
    PHOTOBOX.classList.toggle("hidden");
  });

  document.getElementById("askBtn").addEventListener("click",async()=>{
    const q=document.getElementById("question").value.trim();
    const box=document.getElementById("answer");
    box.classList.remove("hidden");
    if(!q){box.innerHTML="Pehle question likho 😊";return;}
    box.innerHTML="🤖 AI soch raha hai... ⏳";
    try{
      const r=await fetch("/api/ask",{
        method:"POST",
        headers:{"Content-Type":"application/json"},
        body:JSON.stringify({question:q})
      });
      const data=await r.json();
      if(!r.ok) throw new Error(data.error||"Request failed");
      box.innerHTML="<b>🤖 For You AI</b><br><br>"+escapeHtml(data.answer).replace(/\n/g,"<br>");
    }catch(e){
      box.innerHTML="⚠️ Backend connect nahi hua. Server/API key check karo.";
    }
  });

  document.getElementById("voiceBtn").addEventListener("click",()=>{
    const SR=window.SpeechRecognition||window.webkitSpeechRecognition;
    if(!SR){
      alert("Is browser me voice recognition supported nahi hai. Chrome try karo.");
      return;
    }
    const r=new SR();
    r.lang="hi-IN";
    r.onresult=e=>{
      document.getElementById("question").value=e.results[0][0].transcript;
    };
    r.start();
  });

  document.getElementById("photoInput").addEventListener("change",e=>{
    const file=e.target.files[0];
    if(file) alert("Photo select ho gayi: "+file.name);
  });

  function escapeHtml(s){
    return s.replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[m]));
  }
})();
</script>
</body>
</html>
